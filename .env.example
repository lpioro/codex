# Token administratora dashboardu, minimum 32 losowe znaki.
# Generowanie lokalne: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Nie wpisuj go we wtyczkach — każda otrzymuje token endpointu z dashboardu.
PROMPT_TOKEN=

# Port hosta; wewnątrz kontenera aplikacja nadal używa 8787.
PORT=8787

# Opcjonalnie: gotowy, potwierdzony obraz zamiast lokalnego builda.
# PROMPT_IMAGE=ghcr.io/lpioro/codex:0.4.0
# Opcjonalnie: port osobnego projektu demo (Compose 2.24.4+).
# DEMO_PORT=8788

# Tylko dla docker compose --profile tunnel up -d:
# token zdalnie zarządzanego Cloudflare Tunnel, nie token wtyczki.
TUNNEL_TOKEN=

{
  "manifest_version": 3,
  "name": "Prompt Observatory",
  "version": "0.1.0",
  "description": "Opt-in prompt logging for ChatGPT, Claude and Gemini.",
  "permissions": ["storage", "alarms"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "background.js"},
  "options_page": "options.html",
  "action": {"default_title": "Konfiguruj Prompt Observatory"},
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
